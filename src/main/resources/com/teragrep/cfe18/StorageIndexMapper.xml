<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teragrep.cfe18.StorageIndexMapper">

    <!-- insert             ( p_storage_id INT, p_index VARCHAR(255) ) -->
    <select id="create" resultMap="insertedID" statementType="CALLABLE">
        {CALL cfe_18.insert_storage_index(#{param1},#{param2})}
    </select>

    <!-- ID return map -->
    <resultMap id="insertedID" type="com.teragrep.cfe18.handlers.entities.StorageIndex">
        <result property="storageId"       column="storage_id"/>
    </resultMap>

</mapper>

